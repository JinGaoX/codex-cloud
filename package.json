{
  "name": "libretv",
  "version": "2.20.2-personal.12",
  "private": true,
  "description": "免费在线视频搜索与观看平台（Next.js 重构版）",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev -p 8080",
    "prebuild": "node scripts/source-distribution.mjs",
    "build": "next build",
    "build:iphone": "node scripts/build-standalone.mjs",
    "build:pages": "node scripts/build-standalone.mjs --pages",
    "preview:iphone": "node scripts/serve-standalone.mjs",
    "preview:pages": "node scripts/serve-standalone.mjs --pages",
    "start": "next start -p 8080",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:native": "node scripts/build-standalone.mjs --native",
    "native:ios": "npm run build:native && node scripts/prepare-native-ios.mjs",
    "native:ios:open": "cap open ios",
    "preview:native": "node scripts/serve-standalone.mjs --native",
    "catalog:posters": "node --use-env-proxy scripts/update-platform-posters.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.14.12",
    "artplayer": "^5.2.3",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "hls.js": "^1.5.17",
    "mpegts.js": "^1.8.2",
    "mux.js": "^6.3.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.25",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.4.49",
    "sharp": "0.35.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
